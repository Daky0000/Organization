# Deprecated: split into per-package env examples.
# - Web (public Vite vars only): `packages/web/.env.example`
# - API (server-only secrets): `packages/api/.env.example`


# Paystack: keep test and live keys separate. Test is the default and is admin-only.
PAYSTACK_MODE=test
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=
PAYSTACK_CURRENCY=GHS
# Pricing plans and credit packs are denominated in USD. Set an explicit conversion rate.
PAYSTACK_FX_RATE=1
# Optional trusted database CA in PEM format. Remote database certificates are verified.
PG_SSL_CA=
# Demo content is disabled unless explicitly enabled outside production.
ALLOW_DEMO_DATA=false

# Independent credits: rollback blocks new operations; reconciliation always continues.
CREDITS_MANUAL_TEST_ENABLED=true
CREDITS_MANUAL_LIVE_ENABLED=true
# Enable after testing reusable-card charges and refund processing in each mode.
CREDITS_RECHARGE_TEST_ENABLED=false
CREDITS_RECHARGE_LIVE_ENABLED=false
CREDITS_REFUNDS_TEST_ENABLED=false
CREDITS_REFUNDS_LIVE_ENABLED=false

# --- DakyX accounts: "Continue with DakyX" and retainer plans from DakyXTech OS
# (see packages/api/src/server/dakyxRoutes.ts). Leave unset to keep it off.
DAKYX_BASE_URL=https://os.dakyx.com
DAKYX_ISSUER=https://os.dakyx.com
DAKYX_CLIENT_SECRET=
DAKYX_PARTNER_KEY=
